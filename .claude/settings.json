      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git reflog:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(git tag:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git reflog:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git push:*)",
      "PowerShell(git rm:*)",
      "PowerShell(git tag:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Bash(gh label:*)",
      "Bash(gh workflow:*)",
      "Bash(gh repo view:*)",
      "PowerShell(gh pr:*)",
      "PowerShell(gh issue:*)",
      "PowerShell(gh run:*)",
      "PowerShell(gh label:*)",
      "PowerShell(gh workflow:*)",
      "PowerShell(gh repo view:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git rebase:*)",
      "Bash(git push origin +:*)",
      "PowerShell(git push origin +:*)",
      "Bash(gh repo delete:*)",
      "PowerShell(gh repo delete:*)"
    ],
    "ask": [
      "Edit(./next.config.ts)",
      "Write(./next.config.ts)",
      "Edit(./netlify.toml)",
      "Write(./netlify.toml)",
      "Edit(./public/images/**)",
      "Write(./public/images/**)",
      "Bash(gh api -X:*)",
      "PowerShell(gh api -X:*)",
      "Bash(gh api --method:*)",
      "PowerShell(gh api --method:*)",
      "Bash(gh release create:*)",
      "PowerShell(gh release create:*)",
      "Bash(gh release delete:*)",
      "PowerShell(gh release delete:*)",
      "Bash(gh repo edit:*)",
      "PowerShell(gh repo edit:*)",
      "Bash(gh ruleset:*)",
      "PowerShell(gh ruleset:*)",
      "Bash(git config:*)",
      "PowerShell(git config:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "dkj-marketplace": {
      "source": {
        "source": "github",
        "repo": "DKJ-Solutions/dkj-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "dkj-solutions@dkj-marketplace": true,
    "dkj-policy@dkj-marketplace": true,
    "dkj-subagents-alpha@dkj-marketplace": true,
    "figma@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/statusline/dkj-progress.ps1\"",
    "refreshInterval": 2
  }
}